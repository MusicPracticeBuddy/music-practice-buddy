{
  "name": "music-practice-buddy",
  "version": "0.0.0",
  "description": "Utilities to help with tracking practice sessions",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "package:core": "mkdir -p artifacts && npm pack --workspace @music-practice-buddy/core --pack-destination artifacts",
    "check:boundaries": "node scripts/check-core-boundary.mjs"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.13",
    "@music-practice-buddy/core": "0.0.0",
    "@tanstack/solid-router": "^1.170.30",
    "@tanstack/solid-start": "^1.168.47",
    "abc-notation-transposition": "^1.0.6",
    "abcjs": "^6.7.0",
    "pg": "^8.23.0",
    "pg-native": "^3.9.0",
    "solid-js": "^1.9.15",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-babel": "^2.1.0",
    "@rsbuild/plugin-solid": "^1.2.2",
    "@solidjs/testing-library": "^0.8.10",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/sortablejs": "^1.15.9",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
